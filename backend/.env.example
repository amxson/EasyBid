PORT=4000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/easybid
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
NODE_ENV=development
DISABLE_CRON=false

# Required only for registering users, creating auctions, or uploading payment proof.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Required only if email sending is exercised.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SERVICE=
SMTP_MAIL=your-email@example.com
SMTP_PASSWORD=your-smtp-password

# Optional. Preserve this database name for an existing installation.
MONGO_DB_NAME=MERN_AUCTION_PLATFORM
PASSWORD_RESET_URL=http://localhost:5173
CONTACT_EMAIL=
# Use a long random value. Required when invoking /api/internal/jobs.
CRON_SECRET=
# Both are optional; blank values keep bid help in guide mode.
OPENAI_API_KEY=
OPENAI_MODEL=
# Never enable this on a database containing real accounts or auctions.
SEED_DEMO_DATA=false
